<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android asks for this to capture what the phone plays along with its
         screen (AudioPlaybackCapture): asked when the owner turns on "Send
         sound too", and the microphone stays closed. The microphone itself
         is only opened along with the camera, below. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A computer uses this phone's camera and microphone, after the owner
         said Once or Always. Asked right then, never before. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application>
        <service
            android:name="io.sofluffy.ferret_mirroring.MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name="io.sofluffy.ferret_mirroring.CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <activity
            android:name="io.sofluffy.ferret_mirroring.ProjectionConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="false"
            android:taskAffinity="io.sofluffy.ferret_mirroring.consent"
            android:theme="@style/FerretMirroringInvisible" />
    </application>
</manifest>
