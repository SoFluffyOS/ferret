<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android asks for this to capture what the phone plays along with its
         screen (AudioPlaybackCapture). The microphone is never opened. Asked
         only when the owner turns on "Send sound too". -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <service
            android:name="io.sofluffy.ferret_mirroring.MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name="io.sofluffy.ferret_mirroring.ProjectionConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="false"
            android:taskAffinity="io.sofluffy.ferret_mirroring.consent"
            android:theme="@style/FerretMirroringInvisible" />
    </application>
</manifest>
