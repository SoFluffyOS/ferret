<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Opens the phone's own camera app for one photo, only after the
       owner pressed Take photo. No CAMERA permission of its own: the
       camera app takes the picture. -->
  <queries>
    <intent>
      <action android:name="android.media.action.IMAGE_CAPTURE" />
    </intent>
  </queries>

  <application>
    <!-- Hands the camera app one file in Ferret's cache to write the
         photo into. -->
    <provider
      android:name="io.sofluffy.ferret_camera.CameraFileProvider"
      android:authorities="${applicationId}.ferret_camera"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/ferret_camera_paths" />
    </provider>
  </application>
</manifest>
