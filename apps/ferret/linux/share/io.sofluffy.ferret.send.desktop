# "Send with Ferret" in the file manager's Open With menu.
# Copy to ~/.local/share/applications/ (docs/public/features/share-menu.md).
# If `ferret` isn't on your PATH, put its full path after Exec=.
[Desktop Entry]
Type=Application
Version=1.0
Name=Send with Ferret
Comment=Send these files to one of your devices
Exec=ferret send %F
Icon=io.sofluffy.ferret
Terminal=false
NoDisplay=true
StartupNotify=false
Categories=Utility;FileTransfer;
MimeType=application/octet-stream;text/plain;image/jpeg;image/png;image/gif;image/webp;image/heic;video/mp4;video/quicktime;video/x-matroska;audio/mpeg;audio/flac;application/pdf;application/zip;
