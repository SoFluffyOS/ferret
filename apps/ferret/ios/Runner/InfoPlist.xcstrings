{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Info.plist NSCameraUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferret dùng camera để quét mã ghép đôi trên thiết bị kia của bạn, và để chụp ảnh hoặc quét tài liệu cho máy tính khi bạn nhấn Chụp ảnh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferret uses the camera to scan the pairing code on your other device, and to take a photo or scan a document for your computer when you tap Take photo."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Info.plist NSLocalNetworkUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferret kết nối với máy tính và điện thoại của chính bạn trên Wi-Fi này để đồng bộ, và với thiết bị bạn chọn để chia sẻ tệp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferret connects to your own computers and phones on this Wi-Fi to sync with them, and to devices you choose to share files with."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Info.plist NSMicrophoneUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferret không bao giờ dùng micrô. Phần camera dùng để quét mã ghép đôi thì có thể, nên iOS cần dòng này."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferret never uses the microphone. The camera code it scans pairing codes with could, so iOS asks for this line."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Info.plist NSPhotoLibraryUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferret hiện ảnh và ảnh chụp màn hình gần đây của bạn trên những máy tính bạn chọn, chỉ khi Ferret đang mở. Ferret không bao giờ sửa hay xóa ảnh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferret shows your recent photos and screenshots on the computers you choose, only while Ferret is open. It never changes or deletes a photo."
          }
        }
      }
    }
  },
  "version": "1.0"
}
