    },
    "Send link to…": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi liên kết tới…"
          }
        }
      }
    },
    "Send text to…": {
      "extractionState": "manual",
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi văn bản tới…"
