<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer, for Google backups and for moving to a new phone.
     Only the settings go along: the device key never leaves the Keystore,
     so the new phone is a new device and pairs again. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="settings/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="settings/" />
    </device-transfer>
</data-extraction-rules>
