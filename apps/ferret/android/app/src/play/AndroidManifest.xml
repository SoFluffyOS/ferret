<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Google Play updates the apps it installs, and lets no app install
         APKs to update itself. build.gradle.kts merges this file into the
         release build made with dart-define FERRET_STORE=play. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
</manifest>
